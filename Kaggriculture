er_id]\n    private_data = observation[\"private\"]\n\n    money = my_farm[\"money\"]\n    farmer_x, farmer_y = my_farm[\"farmer\"]\n    current_tile = my_farm[\"tiles\"][farmer_y][farmer_x]\n\n    seeds = private_data[\"seeds\"]\n    market_orders = []\n    farmer_action = [\"PASS\"]\n\n    # Buy seeds\n    if seeds.get(\"WHEAT\", 0) == 0 and money >= 10:\n        market_orders.append([\"BUY_SEED\", \"WHEAT\", 1])\n\n    # current tile Work\n    if (\n        isinstance(current_tile, dict)\n        and current_tile.get(\"kind\") == \"PLANT\"\n        and current_tile.get(\"crop\") == \"WHEAT\"\n    ):\n        crop_age = observation[\"day\"] - current_tile.get(\n            \"planted_day\",\n            observation[\"day\"]\n        )\n\n        if crop_age >= 2:\n            farmer_action = [\"HARVEST\"]\n\n        elif not current_tile.get(\"watered_today\", False):\n            farmer_action = [\"WATER\"]\n\n    elif current_tile is None and seeds.get(\"WHEAT\", 0) > 0:\n        farmer_action = [\"PLANT\", \"WHEAT\"]\n\n    # Move only if no planting, watering, or harvesting is needed\n    if farmer_action == [\"PASS\"]:\n        target_x, target_y = route[route_index]\n\n        if (farmer_x, farmer_y) == (target_x, target_y):\n            route_index = (route_index + 1) % len(route)\n            target_x, target_y = route[route_index]\n\n        farmer_action = move_toward(\n            farmer_x,\n            farmer_y,\n            target_x,\n            target_y\n        )\n\n    # Sell wheat in the shed\n    wheat_in_shed = private_data[\"shed\"].get(\"WHEAT\", 0)\n\n    if wheat_in_shed > 0:\n        market_orders.append([\"SELL\", \"WHEAT\", wheat_in_shed])\n\n    return {\n        \"farmer\": farmer_action,\n        \"hands\": [],\n        \"market\": market_orders,\n    }","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"env = make(\n    \"kaggriculture\",\n    configuration={\n        \"episodeSteps\": 100,\