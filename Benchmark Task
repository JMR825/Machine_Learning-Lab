{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.6.6","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/secretiveplotter1863/new-benchmark-task-47bfb?scriptVersionId=341480546\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"cell_type":"code","source":"import kaggle_benchmarks as kbench\nimport re\n\n@kbench.task(name=\"explain what this python prints and why\")\ndef explain_python_prints(llm):\n    code_to_explain = \"\"\"\ndef f(x, acc=[]):\n  acc.append(x)\n  return acc\nprint(f(1)); print(f(2)); print(f(3))\n\"\"\"\n    prompt = f\"Explain in ≤ 60 words what this Python code prints and why:\\n{code_to_explain}\\nEnd with the literal output on its own line.\"\n    \n    response = llm.prompt(prompt)\n\n    # 1. Word Count Assertion\n    # We attempt to isolate the explanation from the literal output at the end\n    output_marker = \"[\"\n    if output_marker in response:\n        explanation_part = response.split(output_marker)[0]\n    else:\n        explanation_part = response\n        \n    word_count = len(explanation_part.split())\n    kbench.assertions.assert_true(\n        word_count <= 60,\n        expectation=f\"The explanation should be 60 words or fewer. Actual count: {word_count}\"\n    )\n\n    # 2. Literal Output Assertion\n    # The code prints [1], then [1, 2], then [1, 2, 3] on separate lines or space-separated.\n    kbench.assertions.assert_contains_regex(\n        r\"\\[1\\][\\s\\S]*?\\[1,\\s*2\\][\\s\\S]*?\\[1,\\s*2,\\s*3\\]\",\n        response,\n        expectation=\"The response must contain the literal output: [1], [1, 2], and [1, 2, 3] in order.\"\n    )\n\n    # 3. Qualitative Assessment with Judge\n    assessment = kbench.assertions.assess_response_with_judge(\n        criteria=[\n            \"The explanation identifies that default arguments (like the list 'acc') are evaluated only once at function definition time.\",\n            \"The explanation correctly describes why the list persists and grows across multiple calls.\",\n            \"The explanation is technically accurate and concise (under 60 words).\"\n        ],\n        response_text=response,\n        judge_llm=kbench.judge_llm\n    )\n\n    if assessment is None:\n        kbench.assertions.assert_fail(\"Judge LLM failed to evaluate the response.\")\n    else:\n        for result in assessment.results:\n            kbench.assertions.assert_true(\n                result.passed, \n                expectation=f\"Criterion '{result.criterion}' failed: {result.reason}\"\n            )\n\nexplain_python_prints.run(kbench.llm)","metadata":{},"outputs":[],"execution_count":null}]}