          nn.Linear(hidden_size, num_classes)\n","        )\n","\n","    def forward(self, x):\n","        return self.network(x)\n","\n","model = IrisModel()"]},{"cell_type":"code","execution_count":11,"id":"fc011baa","metadata":{"execution":{"iopub.execute_input":"2026-10-05T10:57:53.720744Z","iopub.status.busy":"2026-10-05T10:57:53.720276Z","iopub.status.idle":"2026-10-05T10:57:58.720867Z","shell.execute_reply":"2026-10-05T10:57:58.719618Z"},"papermill":{"duration":5.005951,"end_time":"2026-10-05T10:57:58.722347+00:00","exception":false,"start_time":"2026-10-05T10:57:53.716396+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Epoch 010 | train_loss=1.3644 | valid_loss=1.3394 | valid_accuracy=0.3333\n","Epoch 020 | train_loss=1.2168 | valid_loss=1.2076 | valid_accuracy=0.3333\n","Epoch 030 | train_loss=1.1170 | valid_loss=1.1081 | valid_accuracy=0.3333\n","Epoch 040 | train_loss=1.0455 | valid_loss=1.0267 | valid_accuracy=0.3333\n","Epoch 050 | train_loss=0.9724 | valid_loss=0.9607 | valid_accuracy=0.3333\n","Epoch 060 | train_loss=0.9240 | valid_loss=0.9080 | valid_accuracy=0.4333\n","Epoch 070 | train_loss=0.8753 | valid_loss=0.8654 | valid_accuracy=0.8000\n","Epoch 080 | train_loss=0.8431 | valid_loss=0.8292 | valid_accuracy=0.8667\n","Epoch 090 | train_loss=0.8112 | valid_loss=0.7977 | valid_accuracy=0.8333\n","Epoch 100 | train_loss=0.7798 | valid_loss=0.7695 | valid_accuracy=0.7333\n"]}],"source":["import torch.optim as optim\n","\n","criterion = nn.CrossEntropyLoss()\n","optimizer = optim.Adam(model.parameters(),lr =0.0001)\n","\n","for epoch in range(100):\n","    model.train()\n","    train_loss=0.0\n","    for X_batch,y_batch in train_loader:\n","        optimizer.zero_grad()\n","        logit = model(X_batch)\n","        loss= criterion(logit,y_batch)\n","        loss.backward()\n","        optimizer.step()\n","        train_loss+=loss.item()\n","    model.eval()\n","    correct =0\n","    total = 0\n","