\n","        labels_tensor=torch.from_numpy(label.values)\n","        images_tensor=torch.from_numpy(image.values)\n","        \n","        images_tensor=images_tensor.float()/255\n","        labels_tensor=labels_tensor.long()\n","\n","        self.images = images_tensor\n","        self.labels = labels_tensor\n","\n","    def __len__(self):\n","        return len(self.labels)\n","        \n","    def __getitem__(self,idx):\n","        row=self.images[idx]\n","        row= row.view(1,28,28)\n","        row=row.repeat(3,1,1)\n","        row=row.unsqueeze(0)\n","        row=interpolate(row,size=(224,224), mode='bilinear',align_corners=False)\n","        row=row.squeeze(0)\n","        label = self.labels[idx]\n","        return (row,label)\n","\n","        "]},{"cell_type":"code","execution_count":6,"id":"f1094190","metadata":{"execution":{"iopub.execute_input":"2026-08-29T17:50:21.512606Z","iopub.status.busy":"2026-08-29T17:50:21.510688Z","iopub.status.idle":"2026-08-29T17:50:21.940073Z","shell.execute_reply":"2026-08-29T17:50:21.939017Z"},"papermill":{"duration":0.436223,"end_time":"2026-08-29T17:50:21.942755+00:00","exception":false,"start_time":"2026-08-29T17:50:21.506532+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["torch.Size([3, 224, 224]) torch.Size([]) torch.int64 tensor(2)\n"]}],"source":["train_ds = FashionMNISTDataset(train)\n","img, lbl = train_ds[0]\n","print(img.shape, lbl.shape, lbl.dtype, lbl)"]},{"cell_type":"code","execution_count":null,"id":"9dd3bac3","metadata":{"execution":{"iopub.status.busy":"2026-08-29T17:29:43.260289Z","iopub.status.idle":"2026-08-29T17:29:43.260639Z","shell.execute_reply":"2026-08-29T17:29:43.260506Z","shell.execute_reply.started":"2026-08-29T17:29:43.26048Z"},"papermill":{"duration":0.002638,"end_time":"2026-08-29T17:50:21.948278+00:00","exception":false,"start_time":"2026-08-29T17:50:21.94564+00:00","status":"completed"},"tags":[]},"outputs":[],"source":[]},{"cell_type":